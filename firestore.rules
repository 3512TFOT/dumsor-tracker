rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reports collection security
    match /reports/{reportId} {
      
      // Allow anyone to read reports
      allow read: if true;
      
      // Allow anonymous report submission with strict validation
      allow create: if 
        request.resource.data.keys().hasAll(['user', 'text', 'type', 'area', 'timestamp', 'upvotes', 'downvotes', 'deviceId']) &&
        request.resource.data.user == 'Anonymous' &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 200 &&
        request.resource.data.type in ['on', 'off'] &&
        request.resource.data.deviceId is string &&
        request.resource.data.upvotes == 0 &&
        request.resource.data.downvotes == 0 &&
        request.resource.data.timestamp == request.time;

      // Allow voting: ONLY incrementing upvotes/downvotes, NO other changes
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
        request.resource.data.user == resource.data.user && // Prevent user spoofing
        request.resource.data.timestamp == resource.data.timestamp && // Prevent time manipulation
        (
          (request.resource.data.upvotes == resource.data.upvotes + 1 && request.resource.data.downvotes == resource.data.downvotes) ||
          (request.resource.data.downvotes == resource.data.downvotes + 1 && request.resource.data.upvotes == resource.data.upvotes)
        );

      // Prevent deletion
      allow delete: if false;
    }
  }
}
