rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reports collection security
    match /reports/{reportId} {
      
      // Allow anyone to read reports
      allow read: if true;
      
      // Allow anonymous report submission with validation
      allow create: if 
        request.resource.data.keys().hasAll(['user', 'text', 'type', 'area', 'timestamp', 'upvotes', 'downvotes', 'deviceId', 'expiresAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 200 &&
        request.resource.data.type in ['on', 'off'] &&
        request.resource.data.deviceId is string &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.upvotes == 0 &&
        request.resource.data.downvotes == 0 &&
        request.resource.data.timestamp == request.time;

      // Allow voting, but only incrementing upvotes or downvotes
      // Note: Without auth, we can't strictly prevent double-voting on the server, 
      // but we can prevent users from overwriting other fields or decreasing counts.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
        (
          (request.resource.data.upvotes == resource.data.upvotes + 1 && request.resource.data.downvotes == resource.data.downvotes) ||
          (request.resource.data.downvotes == resource.data.downvotes + 1 && request.resource.data.upvotes == resource.data.upvotes)
        );

      // Prevent deletion and general updates
      allow delete: if false;
    }
  }
}
